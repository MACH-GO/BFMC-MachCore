<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bfmc_car">

  <!--  -->
  <!-- Constants                                                              -->
  <!--  -->

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Chassis dimensions and mass 0.18 -->
  <xacro:property name="chassis_len"    value="0.30"/>
  <xacro:property name="chassis_width"  value="0.12"/>
  <xacro:property name="chassis_height" value="0.05"/>
  <xacro:property name="chassis_mass"   value="1.5"/>

  <!-- Vehicle geometry (Ackermann) -->
  <xacro:property name="wheelbase"      value="0.255"/>
  <xacro:property name="track_width"    value="0.165"/>

  <!-- Wheel dimensions -->
  <xacro:property name="wheel_radius"   value="0.03"/>
  <xacro:property name="wheel_width"    value="0.02"/>

  <!-- Chassis placement relative to rear axle (base_link) -->
  <xacro:property name="chassis_x_offset" value="0.13"/>
  <xacro:property name="chassis_z_offset" value="0.005"/> 

  <!--  -->
  <!-- Materials                                                              -->
  <!--  -->

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.4 0.8 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!--  -->
  <!-- Base and Chassis                                                       -->
  <!--  -->

  <!-- Ground-projected frame (Nav2 root) -->
  <link name="base_footprint"/>

  <!-- Rear axle center frame -->
  <link name="base_link"/>

  <!-- base_link elevated to wheel center height -->
  <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Physical chassis body -->
  <link name="chassis_link">
    <visual>
      <geometry>
        <box size="${chassis_len} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <geometry>
        <box size="${chassis_len} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- Box inertia approximation -->
    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia 
        ixx="${chassis_mass/12.0 * (chassis_width*chassis_width + chassis_height*chassis_height)}"
        ixy="0" ixz="0"
        iyy="${chassis_mass/12.0 * (chassis_len*chassis_len + chassis_height*chassis_height)}"
        iyz="0"
        izz="${chassis_mass/12.0 * (chassis_len*chassis_len + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- Chassis offset forward from rear axle -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="${chassis_x_offset} 0 ${chassis_z_offset + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!--  -->
  <!-- IMU                                                                    -->
  <!--  -->

  <!-- IMU mounted centrally on chassis -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${chassis_x_offset} 0 ${chassis_z_offset + chassis_height}" rpy="0 0 0"/>
  </joint>

  <!--  -->
  <!-- Cameras (Front Stereo Pair)                                            -->
  <!--  -->

  <!-- Camera macro: physical + optical frame -->
  <xacro:macro name="camera_sensor" params="prefix y_offset">

    <!-- Camera body -->
    <link name="camera_${prefix}">
      <visual>
        <geometry>
          <box size="0.015 0.03 0.02"/>
        </geometry>
        <material name="black"/>
      </visual>
    </link>

    <!-- Camera mounted on front of chassis -->
    <joint name="camera_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_${prefix}"/>
      <origin 
        xyz="${chassis_x_offset + chassis_len/2 - 0.01} ${y_offset} ${chassis_z_offset + chassis_height + 0.01}"
        rpy="0 0 0"/>
    </joint>

    <!-- Optical frame (ROS camera convention) -->
    <link name="camera_${prefix}_optical"/>
    <joint name="camera_${prefix}_optical_joint" type="fixed">
      <parent link="camera_${prefix}"/>
      <child link="camera_${prefix}_optical"/>
      <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
    </joint>

  </xacro:macro>

  <!-- Left Camera -->
  <xacro:camera_sensor prefix="left"  y_offset="0.04"/>

  <!-- Right Camera -->
  <xacro:camera_sensor prefix="right" y_offset="-0.04"/>

  <!--  -->
  <!-- TOF Sensors (Front Bumper)                                             -->
  <!--  -->

  <!-- TOF macro -->
  <xacro:macro name="tof_sensor" params="prefix y_offset yaw_angle">

    <link name="tof_${prefix}">
      <visual>
        <geometry>
          <cylinder radius="0.005" length="0.005"/>
        </geometry>
        <material name="black"/>
      </visual>
    </link>

    <!-- Mounted on front bumper -->
    <joint name="tof_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="tof_${prefix}"/>
      <origin 
        xyz="${chassis_x_offset + chassis_len/2} ${y_offset} ${chassis_z_offset + chassis_height/2}"
        rpy="0 0 ${yaw_angle}"/>
    </joint>

  </xacro:macro>

  <!-- TOF Left -->
  <xacro:tof_sensor prefix="left"  y_offset="0.06" yaw_angle="0.0"/>

  <!-- TOF Right -->
  <xacro:tof_sensor prefix="right" y_offset="-0.06" yaw_angle="0.0"/>

  <!--  -->
  <!-- Rear Wheels (Driven)                                                   -->
  <!--  -->

  <!-- Rear wheel macro -->
  <xacro:macro name="rear_wheel" params="prefix y_pos">

    <link name="${prefix}_wheel">
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- Small mass for wheel visualization -->
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Wheel rotation joint -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_pos} 0"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

  <!-- Rear Left Wheel (Driven) -->
  <xacro:rear_wheel prefix="rear_left"  y_pos="${track_width/2}"/>

  <!-- Rear Right Wheel -->
  <xacro:rear_wheel prefix="rear_right" y_pos="-${track_width/2}"/>

  <!--  -->
  <!-- Front Steering and Wheels                                              -->
  <!--  -->

  <!-- Front steering macro -->
  <xacro:macro name="front_steering" params="prefix y_pos">

    <!-- Steering knuckle -->
    <link name="${prefix}_steering_link">
      <visual>
        <geometry>
          <cylinder radius="0.01" length="0.01"/>
        </geometry>
        <material name="gray"/>
      </visual>

      <!-- Small mass for steering link -->
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Steering rotation -->
    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>
      <origin xyz="${wheelbase} ${y_pos} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.4" upper="0.4" effort="10.0" velocity="5.0"/>
    </joint>

    <!-- Front wheel -->
    <link name="${prefix}_wheel">
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- Small mass for wheel -->
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Wheel rotation -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

  <!-- Front Left Steering Link -->
  <xacro:front_steering prefix="front_left"  y_pos="${track_width/2}"/>

  <!-- Front Right Steering Link -->
  <xacro:front_steering prefix="front_right" y_pos="-${track_width/2}"/>

  <ros2_control name="BFMCSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- Steering joints -->
    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <!-- Rear wheels -->
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_left_wheel_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

  </ros2_control>

  <!-- LEFT CAMERA -->
  <gazebo reference="camera_left">
    <sensor type="camera" name="left_camera">
      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>

      <plugin name="gazebo_ros_camera_left" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera/left</namespace>
        </ros>
        <camera_name>left</camera_name>
        <image_topic_name>image_raw</image_topic_name>
        <frame_name>camera_left_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- RIGHT CAMERA -->
  <gazebo reference="camera_right">
    <sensor type="camera" name="right_camera">
      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>

      <plugin name="gazebo_ros_camera_right" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera/right</namespace>
        </ros>
        <camera_name>right</camera_name>
        <image_topic_name>image_raw</image_topic_name>
        <frame_name>camera_right_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>


  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find mach_simulator)/config/ros2_control.yaml</parameters>
    </plugin>
  </gazebo>

</robot>